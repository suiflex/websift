# Review owners. The last matching pattern wins, so specific paths go below the default.
#
# Every owner here must be a team that exists in the suiflex org and has write access to this
# repository. GitHub does not report an unresolvable owner: it silently requests no review, so a
# broken file looks exactly like a working one. Verify on a real pull request.

# Default owner for everything.
*                       @suiflex/maintainers

# Retrieval policy and the robots gate carry the invariants documented in CLAUDE.md.
/src/policy/            @suiflex/maintainers
/src/robots.rs          @suiflex/maintainers
/src/fetch/             @suiflex/maintainers

# Release, distribution, and self-update paths.
/.github/workflows/     @suiflex/maintainers
/install.sh             @suiflex/maintainers
/install.ps1            @suiflex/maintainers
/src/update.rs          @suiflex/maintainers

# Project governance.
/SECURITY.md            @suiflex/maintainers
/CODE_OF_CONDUCT.md     @suiflex/maintainers
/LICENSE                @suiflex/maintainers
