{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websift.dev/schemas/worker-v1.schema.json",
  "title": "Websift worker protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "worker_version", "capabilities"],
      "properties": {
        "type": { "const": "hello" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "worker_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "const": "extract" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "operation", "deadline_ms", "spool_id", "options"],
      "properties": {
        "type": { "const": "request" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "operation": { "enum": ["extract", "render"] },
        "url": { "type": "string", "format": "uri", "maxLength": 8192 },
        "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "spool_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formats", "only_main_content", "wait_for_ms", "max_output_chars"],
          "properties": {
            "formats": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "enum": ["markdown", "raw_html"]
              }
            },
            "only_main_content": { "type": "boolean" },
            "wait_for_ms": { "type": "integer", "minimum": 0, "maximum": 30000 },
            "max_output_chars": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id"],
      "properties": {
        "type": { "const": "cancel" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version"],
      "properties": {
        "type": { "const": "heartbeat" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "media_type", "bytes", "sha256"],
      "properties": {
        "kind": { "enum": ["markdown", "raw_html"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "status", "artifacts", "warnings", "timing_ms"],
      "properties": {
        "type": { "const": "result" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "status": { "const": "ok" },
        "final_url": { "type": "string", "format": "uri", "maxLength": 8192 },
        "artifacts": {
          "type": "array",
          "maxItems": 7,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 512 }
        },
        "timing_ms": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "status", "code", "message", "retryable"],
      "properties": {
        "type": { "const": "error" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "status": { "const": "error" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
