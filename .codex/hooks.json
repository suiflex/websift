{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "forgeguard hook scope --agent codex",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "apply_patch|Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "forgeguard hook context --agent codex",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "forgeguard hook stop --agent codex",
            "timeout": 600,
            "type": "command"
          }
        ]
      }
    ]
  }
}
